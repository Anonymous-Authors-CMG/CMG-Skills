# Copy to .env (git-ignored) and `set -a; source .env; set +a` before running.
# Pick ONE backend.

# A) An agent CLI you are logged in to
# CM_LLM_CMD=claude          # codex | gemini | codebuddy | cursor-agent | opencode
# CM_LLM_MODEL=              # optional, passed as --model

# B) Any OpenAI-compatible API
# CM_API_KEY=sk-...
# CM_BASE_URL=https://api.deepseek.com
# CM_LLM_MODEL=deepseek-chat

# GitHub (raises the issue-fetch limit from 60 to 5000 requests/hour)
# GITHUB_TOKEN=ghp_...
