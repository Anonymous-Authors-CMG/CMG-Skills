+import importlib
+import os
+import sys
+import tempfile
+
+from keras.src import testing
+from keras.src.utils.module_utils import OrbaxLazyModule
+
+
+class OrbaxLazyModuleTest(testing.TestCase):
+    def test_available_is_false_without_v1_api(self):
+        """An orbax.checkpoint predating the v1 API must report unavailable.
+
+        The module imports cleanly but has no `v1` attribute, which used to let
+        an AttributeError escape the `available` property.
+        """
+        tmp = tempfile.mkdtemp()
+        pkg = os.path.join(tmp, "orbax", "checkpoint")
+        os.makedirs(pkg)
+        # `orbax` stays a namespace dir, as the real distribution ships it;
+        # `checkpoint` is a regular package that simply has no `v1`.
+        with open(os.path.join(pkg, "__init__.py"), "w") as f:
+            f.write("")
+
+        sys.path.insert(0, tmp)
+        saved = {k: v for k, v in sys.modules.items() if k.startswith("orbax")}
+        for k in saved:
+            del sys.modules[k]
+        importlib.invalidate_caches()
+        try:
+            ocp = OrbaxLazyModule("orbax")
+            self.assertFalse(ocp.available)
+        finally:
+            sys.path.remove(tmp)
+            for k in [k for k in sys.modules if k.startswith("orbax")]:
+                del sys.modules[k]
+            sys.modules.update(saved)
